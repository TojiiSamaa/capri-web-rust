# Copy to .env (Docker and npm) or .env.local (npm only). Everything here is optional: the settings page can do it all.
# Port on this machine where Docker serves the app. Only this machine can reach it.
PORT=3000
# Any OpenAI-compatible provider works. The key stays on the server.
CAPRI_API_KEY=
CAPRI_MODEL=gpt-4o-mini
# Optional, defaults to OpenAI:
# CAPRI_API_URL=https://openrouter.ai/api/v1
